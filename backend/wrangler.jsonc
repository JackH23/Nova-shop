{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-shop-customer-api",
  "main": "worker.js",
  "vars": {
    "EMAIL_USER": "sihalardjacky@gmail.com",
    "JWT_ACCESS_EXPIRES_IN": "1m",
    "JWT_REFRESH_EXPIRES_IN": "7d"
  },
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "73cea7bc13eb4f04a1b7683f786f177d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "nova-shop-customer-uploads"
    }
  ],
  "observability": {
    "enabled": true
  }
}